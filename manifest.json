{
  "manifest_version": 3,
  "name": "LinkedIn Company Preview",
  "version": "1.0.0",
  "permissions": [
    "sidePanel",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Company Preview"
  }
}